{
  "name": "panoptes-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Panoptes — Observability for your entire business. Marketing website (Astro, static, Cloudflare Pages).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "assets": "node scripts/generate-assets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-concurrency=1 tests/*.test.ts tests/blog-build.test.mjs tests/blog-e2e.test.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test tests/*.test.ts",
    "validate:seo": "python3 scripts/validate_seo.py"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "opentype.js": "^2.0.0",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
