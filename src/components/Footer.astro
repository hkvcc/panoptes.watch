---
import Logo from './Logo.astro';
import CopyEmail from './CopyEmail.astro';
import { FOOTER, SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container container-wide">
    <div class="ft-top">
      <div class="ft-brand">
        <a href="/" aria-label="Panoptes home"><Logo /></a>
        <p class="ft-tag">{SITE.tagline}</p>
        <p class="muted small">Your systems tell you they're running. Panoptes tells you whether your business is working.</p>
        <CopyEmail email={SITE.salesEmail} />
      </div>
      <div class="ft-cols">
        {FOOTER.map((col) => (
          <nav class="ft-col" aria-label={col.title}>
            <p class="ft-title">{col.title}</p>
            <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="ft-bottom">
      <span>© {year} Panoptes. All rights reserved.</span>
      <span class="ft-links"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/cookies/">Cookies</a><a href="/sitemap.xml">Sitemap</a></span>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--border); background: var(--bg-2); padding: clamp(56px, 7vw, 88px) 0 32px; font-size: .92rem; }
  .ft-top { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: clamp(32px, 6vw, 80px); }
  .ft-brand :global(.logo) { height: 28px; }
  .ft-tag { font: 600 1.1rem/1.3 var(--font-display); margin: 1.2rem 0 .5rem; }
  .ft-cols { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; }
  .ft-title { font: 500 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); margin: 0 0 1rem; }
  .ft-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .55rem; }
  .ft-col a, .ft-links a { color: var(--text-2); text-decoration: none; }
  .ft-col a:hover, .ft-links a:hover { color: var(--accent-text); }
  .ft-bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: var(--text-3); font-size: .84rem; }
  .ft-links { display: flex; gap: 20px; flex-wrap: wrap; }
  @media (max-width: 1080px) { .ft-top { grid-template-columns: 1fr; } .ft-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ft-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
