---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="container container-wide hdr">
    <a href="/" class="brand" aria-label="Panoptes home"><Logo /></a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-list">
        {NAV.map((g, i) => (
          <li class="nav-item" data-nav-item>
            <button type="button" class:list={['nav-trigger', { active: isActive(g.href) }]} aria-expanded="false" aria-controls={`mega-${i}`} data-nav-trigger>
              {g.label}<Icon name="chevron" class="chev" />
            </button>
            <div class="mega" id={`mega-${i}`} data-mega hidden>
              <div class:list={['mega-inner', { 'has-feature': !!g.feature, wide: g.columns.length > 1 || g.columns[0].links.length > 6 }]}>
                <div class="mega-cols">
                  {g.columns.map((col) => (
                    <div class="mega-col">
                      {col.title && <p class="mega-title">{col.title}</p>}
                      <ul class:list={['mega-links', { two: col.links.length > 6 }]}>
                        {col.links.map((l) => (
                          <li>
                            <a href={l.href} class="mega-link" aria-current={path === l.href ? 'page' : undefined}>
                              {l.icon && <span class="mega-ico"><Icon name={l.icon} /></span>}
                              <span><strong>{l.label}</strong>{l.desc && <small>{l.desc}</small>}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                {g.feature ? (
                  <a href={g.feature.href} class="mega-feature">
                    <span class="eyebrow">Featured</span>
                    <strong>{g.feature.title}</strong>
                    <span>{g.feature.text}</span>
                    <span class="link-arrow">{g.feature.cta}</span>
                  </a>
                ) : null}
              </div>
              <div class="mega-foot"><span>{g.intro}</span><a href={g.href} class="link-arrow">{g.label} overview</a></div>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr-actions">
      <ThemeToggle />
      <a href="/demo/" class="btn btn-primary btn-sm hdr-cta">Book a Demo</a>
      <button type="button" class="icon-btn nav-burger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" data-burger>
        <span class="b-open"><Icon name="menu" /></span><span class="b-close"><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav aria-label="Mobile">
      {NAV.map((g, i) => (
        <details class="m-group">
          <summary>{g.label}<Icon name="chevron" class="chev" /></summary>
          <ul>
            <li><a href={g.href}>{g.label} overview</a></li>
            {g.columns.flatMap((c) => c.links).filter((l) => l.href !== g.href).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </details>
      ))}
      <div class="m-actions">
        <a href="/demo/" class="btn btn-primary">Book a Demo</a>
        <a href="/contact/" class="btn">Contact</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid transparent; transition: border-color .2s, background .2s; }
  .site-header:global(.scrolled) { border-bottom-color: var(--border); }
  .hdr { display: flex; align-items: center; gap: 24px; height: var(--header-h); }
  .brand { display: inline-flex; flex: none; border-radius: 6px; }
  .brand :global(.logo) { height: 28px; }
  .nav-desktop { flex: 1; display: flex; justify-content: center; }
  .nav-list { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-trigger { display: inline-flex; align-items: center; gap: 4px; background: none; border: 0; padding: 10px 12px; border-radius: 999px; font: 500 .92rem/1 var(--font-body); color: var(--text-2); cursor: pointer; transition: color .15s, background .15s; }
  .nav-trigger:hover, .nav-trigger[aria-expanded='true'], .nav-trigger.active { color: var(--text); }
  .nav-trigger[aria-expanded='true'] { background: var(--bg-2); }
  .nav-trigger :global(.chev) { width: 14px; height: 14px; transition: transform .2s var(--ease); opacity: .7; }
  .nav-trigger[aria-expanded='true'] :global(.chev) { transform: rotate(180deg); }
  .mega { position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); background: var(--elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); min-width: 380px; overflow: hidden; animation: mega-in .18s var(--ease); }
  @keyframes mega-in { from { opacity: 0; transform: translate(-50%, -6px); } }
  .mega-inner { display: grid; padding: 14px; gap: 10px; }
  .mega-inner.has-feature { grid-template-columns: 1fr 240px; }
  .mega-inner.wide { min-width: 760px; }
  .mega-inner.wide .mega-links.two { grid-template-columns: repeat(2, minmax(220px, 1fr)); }
  .mega-cols { display: grid; grid-auto-flow: column; gap: 10px; }
  .mega-title { font: 500 .7rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); margin: 8px 10px 10px; }
  .mega-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .mega-links.two { grid-template-columns: 1fr 1fr; }
  .mega-link { display: flex; gap: 12px; align-items: flex-start; padding: 10px; border-radius: 10px; text-decoration: none; color: var(--text); }
  .mega-link:hover, .mega-link:focus-visible { background: var(--bg-2); }
  .mega-link strong { display: block; font-weight: 600; font-size: .9rem; line-height: 1.3; }
  .mega-link small { display: block; color: var(--text-2); font-size: .8rem; line-height: 1.35; margin-top: 2px; }
  .mega-ico { width: 32px; height: 32px; flex: none; display: grid; place-items: center; border-radius: 9px; background: var(--accent-soft); color: var(--accent-text); }
  .mega-ico :global(svg) { width: 17px; height: 17px; }
  .mega-feature { display: flex; flex-direction: column; gap: 8px; padding: 18px; border-radius: 12px; text-decoration: none; color: var(--text-2); font-size: .86rem; line-height: 1.5; background: linear-gradient(160deg, var(--accent-soft), transparent 80%), var(--surface-2); border: 1px solid var(--border); }
  .mega-feature strong { color: var(--text); font-family: var(--font-display); font-size: 1.05rem; }
  .mega-feature .eyebrow { margin: 0; }
  .mega-feature .link-arrow { margin-top: auto; font-size: .86rem; }
  .mega-foot { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 12px 24px; border-top: 1px solid var(--border); background: var(--surface-2); font-size: .82rem; color: var(--text-2); }
  .mega-foot .link-arrow { font-size: .84rem; white-space: nowrap; }
  .nav-item:first-child .mega, .nav-item:nth-child(2) .mega { left: 0; transform: none; animation-name: mega-in-l; }
  .nav-item:last-child .mega, .nav-item:nth-last-child(2) .mega { left: auto; right: 0; transform: none; animation-name: mega-in-l; }
  @keyframes mega-in-l { from { opacity: 0; transform: translateY(-6px); } }

  .hdr-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  .nav-burger { display: none; }
  .nav-burger .b-close { display: none; }
  .nav-burger[aria-expanded='true'] .b-open { display: none; }
  .nav-burger[aria-expanded='true'] .b-close { display: grid; }
  .nav-burger span { display: grid; }

  .mobile-nav { border-top: 1px solid var(--border); background: var(--bg); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .mobile-nav nav { padding: 8px var(--gutter) 28px; }
  .m-group { border-bottom: 1px solid var(--border); }
  .m-group summary { list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 16px 0; font: 600 1.05rem/1 var(--font-display); cursor: pointer; }
  .m-group summary::-webkit-details-marker { display: none; }
  .m-group summary :global(.chev) { width: 18px; height: 18px; transition: transform .2s; }
  .m-group[open] summary :global(.chev) { transform: rotate(180deg); }
  .m-group ul { list-style: none; padding: 0 0 14px; margin: 0; display: grid; gap: 2px; }
  .m-group a { display: block; padding: 10px 12px; border-radius: 10px; color: var(--text-2); text-decoration: none; }
  .m-group a:hover { background: var(--bg-2); color: var(--text); }
  .m-actions { display: grid; gap: 10px; margin-top: 22px; }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .nav-burger { display: grid; }
  }
  @media (max-width: 480px) {
    .hdr-cta { display: none; }
    .brand :global(.logo) { height: 24px; }
  }
</style>
