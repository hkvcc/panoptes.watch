---
import type { Crumb } from '../layouts/BaseLayout.astro';
interface Props { eyebrow?: string; title: string; lede?: string; breadcrumbs?: Crumb[]; split?: boolean; center?: boolean }
const { eyebrow, title, lede, breadcrumbs, split = false, center = false } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---
<section class:list={['page-hero bg-glow', { center }]}>
  <div class="bg-grid-layer bg-grid" aria-hidden="true"></div>
  <div class:list={['container', { 'split': split && hasVisual, 'split-top': false }]}>
    <div class="ph-copy">
      {breadcrumbs && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {breadcrumbs.map((c, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>)}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {hasVisual && <div class:list={['ph-visual', { 'mt-3': !split }]}><slot name="visual" /></div>}
  </div>
</section>
<style>
  .center { text-align: center; }
  .center .ph-copy { display: flex; flex-direction: column; align-items: center; }
  .center h1 { max-width: 20ch; }
  .center :global(.breadcrumbs ol) { justify-content: center; }
  .split :global(h1) { max-width: 14ch; }
</style>
