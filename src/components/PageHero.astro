---
import type { Crumb } from '../layouts/BaseLayout.astro';
/**
 * `keyword` (optional) is the page's target phrase. It renders inside the <h1>, styled like the
 * eyebrow, so the heading is keyword-led while the display line stays human; it replaces `eyebrow`.
 */
interface Props { eyebrow?: string; keyword?: string; title: string; lede?: string; breadcrumbs?: Crumb[]; split?: boolean; center?: boolean }
const { eyebrow, keyword, title, lede, breadcrumbs, split = false, center = false } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---
<section class:list={['page-hero bg-glow', { center }]}>
  <div class="bg-grid-layer bg-grid" aria-hidden="true"></div>
  <div class:list={['container', { 'split': split && hasVisual, 'split-top': false }]}>
    <div class="ph-copy">
      {breadcrumbs && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {breadcrumbs.map((c, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>)}
          </ol>
        </nav>
      )}
      {keyword ? (
        <h1><span class="eyebrow h1-kicker">{keyword}<span class="sr-only">: </span></span> <span class="h1-main" set:html={title} /></h1>
      ) : (
        <Fragment>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1 set:html={title} />
        </Fragment>
      )}
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {hasVisual && <div class:list={['ph-visual', { 'mt-3': !split }]}><slot name="visual" /></div>}
  </div>
</section>
<style>
  .center { text-align: center; }
  .center .ph-copy { display: flex; flex-direction: column; align-items: center; }
  .center h1 { max-width: 20ch; }
  .center :global(.breadcrumbs ol) { justify-content: center; }
  .split :global(h1) { max-width: 14ch; }
  .h1-kicker { display: flex; width: fit-content; max-width: 100%; }
  .h1-main { display: block; }
  .center .h1-kicker { margin-inline: auto; }
</style>
