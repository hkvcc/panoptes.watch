---
/** Compact list of related pages, used at the bottom of platform/solution/use-case pages. */
import Icon from './Icon.astro';
interface Props { title?: string; eyebrow?: string; items: { label: string; href: string; desc?: string; icon?: string }[] }
const { title = 'Related', eyebrow, items } = Astro.props;
---
<div class="related">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="related-title">{title}</h2>
  <ul class="related-list">
    {items.map((i) => (
      <li>
        <a href={i.href} class="related-item">
          {i.icon && <span class="icon-tile"><Icon name={i.icon} /></span>}
          <span class="ri-body"><strong>{i.label}</strong>{i.desc && <span>{i.desc}</span>}</span>
          <Icon name="arrow" class="ri-arrow" />
        </a>
      </li>
    ))}
  </ul>
</div>
<style>
  .related-title { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .related-list { list-style: none; padding: 0; margin: 1.6rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .related-item { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); text-decoration: none; color: var(--text); height: 100%; transition: border-color .15s; }
  .related-item:hover { border-color: var(--accent); }
  .related-item:focus-visible { outline-offset: 2px; }
  .related-item .icon-tile { margin: 0; width: 38px; height: 38px; }
  .ri-body { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .ri-body strong { font-weight: 600; font-size: .95rem; }
  .ri-body span { font-size: .84rem; color: var(--text-2); line-height: 1.4; }
  .related-item :global(.ri-arrow) { width: 18px; height: 18px; color: var(--text-3); flex: none; transition: transform .2s, color .2s; }
  .related-item:hover :global(.ri-arrow) { color: var(--accent-text); transform: translateX(3px); }
</style>
