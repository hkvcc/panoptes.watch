---
/**
 * Long-form document page used by /company/vision/ and the legal pages.
 * Renders a compact hero, an "On this page" table of contents derived from the
 * body's <h2> headings (highlighted by the shared article-TOC script) and a .prose body.
 * `draft` adds a visible legal-review notice listing the placeholders still to be filled.
 */
import BaseLayout, { type Crumb } from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  eyebrow: string;
  lede: string;
  breadcrumbs: Crumb[];
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  updated?: string;          // human-readable "last updated" text
  draft?: boolean;
  placeholders?: string[];   // listed in the draft notice
}
const { title, metaTitle, description, eyebrow, lede, breadcrumbs, ogImage = '/social/og-company.png', schema, updated, draft = false, placeholders = [] } = Astro.props;

const slug = (s: string) => s.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
let body = await Astro.slots.render('default');
const toc: { id: string; text: string }[] = [];
body = body.replace(/<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/g, (_m, attrs = '', inner) => {
  const existing = /id="([^"]+)"/.exec(attrs);
  const id = existing ? existing[1] : slug(inner);
  toc.push({ id, text: inner.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&') });
  return existing ? `<h2${attrs}>${inner}</h2>` : `<h2 id="${id}"${attrs}>${inner}</h2>`;
});
---
<BaseLayout title={metaTitle ?? title.replace(/<[^>]+>/g, '')} description={description} ogImage={ogImage} schema={schema} breadcrumbs={breadcrumbs}>
  <header class="doc-hero bg-glow">
    <div class="bg-grid doc-grid" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {breadcrumbs.map((c, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>)}
        </ol>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={title} />
      <p class="lede">{lede}</p>
      {updated && <p class="doc-meta"><Icon name="calendar" /> Last updated: {updated}</p>}
    </div>
  </header>

  <div class="container doc-layout">
    {toc.length > 2 && (
      <aside class="doc-toc" aria-label="Table of contents">
        <details open class="toc-box">
          <summary>On this page</summary>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`} data-toc-link>{t.text}</a></li>)}</ol>
        </details>
      </aside>
    )}
    <div class="doc-main">
      {draft && (
        <div class="draft-notice" role="note">
          <p class="dn-title"><Icon name="alert" /> Draft — pending legal review</p>
          <p>Draft — this document has not been reviewed by legal counsel and is provided for structure only. It does not yet create, waive or limit any legal rights or obligations.</p>
          {placeholders.length > 0 && (
            <>
              <p class="dn-sub">Details still to be confirmed (shown in square brackets below):</p>
              <ul>{placeholders.map((p) => <li><code>{p}</code></li>)}</ul>
            </>
          )}
        </div>
      )}
      <article class="prose doc-body">
        <Fragment set:html={body} />
      </article>
      <slot name="after" />
    </div>
  </div>
  <slot name="end" />
</BaseLayout>

<style>
  .doc-hero { padding: clamp(48px, 7vw, 96px) 0 clamp(32px, 5vw, 56px); border-bottom: 1px solid var(--border); position: relative; overflow: hidden; isolation: isolate; }
  .doc-grid { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); }
  .doc-hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); max-width: 22ch; }
  .doc-hero .lede { max-width: 62ch; }
  .doc-meta { display: inline-flex; align-items: center; gap: 8px; margin: 1.2rem 0 0; font: 500 .8rem/1 var(--font-mono); color: var(--text-3); }
  .doc-meta :global(svg) { width: 15px; height: 15px; }
  .doc-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); padding-block: clamp(40px, 6vw, 72px) var(--section); align-items: start; }
  .doc-layout:not(:has(.doc-toc)) { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .doc-main { min-width: 0; }
  .doc-toc { position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 48px); overflow: auto; }
  .toc-box summary { font: 500 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); cursor: pointer; padding: 6px 0 14px; list-style: none; }
  .toc-box summary::-webkit-details-marker { display: none; }
  .toc-box ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--border); }
  .toc-box a { display: block; padding: 7px 0 7px 16px; margin-left: -1px; border-left: 2px solid transparent; color: var(--text-2); text-decoration: none; font-size: .88rem; line-height: 1.4; }
  .toc-box a:hover { color: var(--text); }
  .toc-box a.active { color: var(--accent-text); border-left-color: var(--accent); font-weight: 600; }
  .doc-body { max-width: 72ch; }
  .doc-body :global(> h2:first-child) { margin-top: 0; }
  .doc-body :global(p code), .doc-body :global(li code) { overflow-wrap: anywhere; }
  .draft-notice { max-width: 72ch; border: 1px solid var(--warn); background: var(--warn-bg); color: var(--text); border-radius: var(--radius); padding: 1.1rem 1.3rem; margin-bottom: 2.4rem; font-size: .95rem; }
  .draft-notice p { margin: 0 0 .6rem; }
  .dn-title { display: flex; align-items: center; gap: 8px; font: 600 1rem/1.3 var(--font-display); color: var(--warn-text); }
  .dn-title :global(svg) { width: 18px; height: 18px; flex: none; }
  .dn-sub { font-weight: 600; margin-top: .9rem !important; }
  .draft-notice ul { margin: 0; padding-left: 1.2rem; display: grid; gap: .25rem; }
  .draft-notice code { font-size: .84rem; overflow-wrap: anywhere; }
  @media (max-width: 960px) {
    .doc-layout { grid-template-columns: minmax(0, 1fr); }
    .doc-toc { position: static; max-height: none; border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 18px; background: var(--surface-2); }
    .toc-box summary { padding-bottom: 0; }
    .toc-box[open] summary { padding-bottom: 12px; }
  }
</style>
