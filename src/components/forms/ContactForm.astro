---
import FormShell from './FormShell.astro';
import { TOPIC_OPTIONS, LIMITS } from './schema';
interface Props { topic?: string }
const { topic = '' } = Astro.props;
const id = 'contact-form';
const f = (n: string) => `${id}-${n}`;
---
<FormShell kind="contact" id={id} label="Contact Panoptes" submitLabel="Send message" success="Thank you — your message has been sent. We will reply by email.">
  <div class="form-grid">
    <div class="field">
      <label for={f('name')}>Full name<span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={f('name')} name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} aria-describedby={f('name-error')} />
      <p class="field-error" id={f('name-error')} data-error-for="name"></p>
    </div>
    <div class="field">
      <label for={f('email')}>Email<span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={f('email')} name="email" type="email" autocomplete="email" inputmode="email" required maxlength={LIMITS.email} aria-describedby={f('email-error')} />
      <p class="field-error" id={f('email-error')} data-error-for="email"></p>
    </div>
    <div class="field">
      <label for={f('company')}>Company <span class="opt">(optional)</span></label>
      <input class="input" id={f('company')} name="company" type="text" autocomplete="organization" maxlength={LIMITS.company} aria-describedby={f('company-error')} />
      <p class="field-error" id={f('company-error')} data-error-for="company"></p>
    </div>
    <div class="field">
      <label for={f('topic')}>Topic<span class="req" aria-hidden="true">*</span></label>
      <select class="select" id={f('topic')} name="topic" required aria-describedby={f('topic-error')}>
        <option value="">Choose a topic</option>
        {TOPIC_OPTIONS.map((o) => <option value={o.value} selected={o.value === topic}>{o.label}</option>)}
      </select>
      <p class="field-error" id={f('topic-error')} data-error-for="topic"></p>
    </div>
    <div class="field full">
      <label for={f('message')}>Message<span class="req" aria-hidden="true">*</span></label>
      <textarea class="textarea" id={f('message')} name="message" required minlength={LIMITS.messageMin} maxlength={LIMITS.message} aria-describedby={f('message-error')}></textarea>
      <p class="field-error" id={f('message-error')} data-error-for="message"></p>
    </div>
    <div class="field full">
      <label class="check"><input type="checkbox" id={f('consent')} name="consent" required aria-describedby={f('consent-error')} /> <span>I agree that Panoptes may use these details to respond to my message, as described in the <a href="/privacy/">privacy notice</a>.<span class="req" aria-hidden="true">*</span></span></label>
      <p class="field-error" id={f('consent-error')} data-error-for="consent"></p>
    </div>
  </div>
</FormShell>
