---
/**
 * Searchable, filterable directory of example systems by category.
 * Without JS every entry is visible and the search/filter toolbar is hidden.
 */
import IntegrationIcon from './IntegrationIcon.astro';
import { CATEGORIES, ENTRIES, STATUS_LABEL, monogram } from './directory';
const total = ENTRIES.length;
const searchText = (e: (typeof ENTRIES)[number], cat: string) => [e.name, cat, e.detail, e.keywords ?? '', e.kind === 'pattern' ? 'pattern' : 'example'].join(' ').toLowerCase();
---
<div class="dir" data-directory>
  <div class="dir-tools">
    <div class="dir-search">
      <label for="dir-q">Search the directory</label>
      <div class="dir-input">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
        <input type="search" id="dir-q" class="input" placeholder="System, category or data — e.g. invoices" autocomplete="off" spellcheck="false" aria-describedby="dir-count" />
      </div>
    </div>
    <div class="dir-filters" role="group" aria-label="Filter by category">
      <button type="button" class="dir-chip" data-filter="all" aria-pressed="true">All <span class="dir-n">{total}</span></button>
      {CATEGORIES.map((c) => (
        <button type="button" class="dir-chip" data-filter={c.id} aria-pressed="false">{c.label} <span class="dir-n">{ENTRIES.filter((e) => e.category === c.id).length}</span></button>
      ))}
    </div>
    <p class="dir-count" id="dir-count" aria-live="polite" aria-atomic="true">Showing all {total} examples</p>
  </div>

  <div class="dir-groups">
    {CATEGORIES.map((c) => (
      <section class="dir-group" data-group={c.id} aria-labelledby={`dir-h-${c.id}`}>
        <header class="dir-gh">
          <span class="icon-tile"><IntegrationIcon name={c.icon} /></span>
          <div>
            <h3 id={`dir-h-${c.id}`}>{c.label}</h3>
            <p class="muted small">{c.contributes}</p>
          </div>
        </header>
        <ul class="dir-grid">
          {ENTRIES.filter((e) => e.category === c.id).map((e) => (
            <li class="dir-item" data-cat={c.id} data-search={searchText(e, c.label)}>
              <div class="dir-top">
                <span class="dir-mono" aria-hidden="true">{monogram(e.name)}</span>
                <div class="dir-name">
                  <strong>{e.name}</strong>
                  <span class="dir-kind">{e.kind === 'pattern' ? 'Integration pattern' : 'Example system'}</span>
                </div>
              </div>
              <p class="dir-detail">{e.detail}</p>
              <p class="dir-status"><span class="dot" aria-hidden="true"></span>{STATUS_LABEL}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="dir-empty card card-tint" hidden>
    <h3>No examples match that search</h3>
    <p class="muted">The directory lists examples, not a complete catalogue. If a system can export data, expose an API or emit events, it can usually be evaluated as a source.</p>
    <div class="btn-row">
      <button type="button" class="btn btn-sm" data-clear>Clear search and filters</button>
      <a href="/integrations/api/" class="btn btn-sm btn-ghost">Send events via the API</a>
      <a href="/contact/" class="btn btn-sm btn-ghost">Ask about your system</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-directory]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('#dir-q')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('.dir-item')];
    const groups = [...root.querySelectorAll<HTMLElement>('.dir-group')];
    const count = root.querySelector<HTMLElement>('.dir-count')!;
    const empty = root.querySelector<HTMLElement>('.dir-empty')!;
    const total = items.length;
    let filter = 'all';

    const labelOf = (id: string) => chips.find((c) => c.dataset.filter === id)?.firstChild?.textContent?.trim() ?? id;

    function apply() {
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const it of items) {
        const ok = (filter === 'all' || it.dataset.cat === filter) && terms.every((t) => it.dataset.search!.includes(t));
        it.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('.dir-item:not([hidden])');
      empty.hidden = shown > 0;
      const scope = filter === 'all' ? '' : ` in ${labelOf(filter)}`;
      const q = input.value.trim() ? ` matching “${input.value.trim()}”` : '';
      count.textContent = shown === total ? `Showing all ${total} examples`
        : shown === 0 ? `No examples${scope}${q}`
        : `Showing ${shown} of ${total} examples${scope}${q}`;
    }

    chips.forEach((chip) => chip.addEventListener('click', () => {
      filter = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    }));
    input.addEventListener('input', apply);
    input.addEventListener('keydown', (e) => { if (e.key === 'Escape' && input.value) { input.value = ''; apply(); } });
    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      input.value = ''; filter = 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === 'all')));
      apply(); input.focus();
    });
    apply();
  });
</script>

<style>
  :global(.no-js) .dir-tools { display: none; }
  .dir-tools { display: grid; gap: 16px; margin-bottom: clamp(28px, 4vw, 44px); padding: clamp(16px, 2vw, 22px); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); }
  .dir-search { display: grid; gap: .45rem; }
  .dir-search label { font-weight: 600; font-size: .9rem; }
  .dir-input { position: relative; }
  .dir-input svg { position: absolute; left: 14px; top: 50%; width: 18px; height: 18px; margin-top: -9px; color: var(--text-3); pointer-events: none; }
  .dir-input .input { padding-left: 42px; }
  .dir-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .dir-chip { appearance: none; display: inline-flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 14px; border: 1px solid var(--border-strong); border-radius: 999px; background: var(--surface); color: var(--text-2); font: 600 .86rem/1 var(--font-body); cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
  .dir-chip:hover { border-color: var(--accent); color: var(--text); }
  .dir-chip[aria-pressed='true'] { background: var(--purple); border-color: var(--purple); color: #fff; }
  .dir-n { font: 500 .72rem/1 var(--font-mono); padding: 3px 6px; border-radius: 999px; background: var(--bg-2); color: var(--text-3); }
  .dir-chip[aria-pressed='true'] .dir-n { background: rgba(255, 255, 255, .2); color: #fff; }
  .dir-count { margin: 0; font: 500 .8rem/1.4 var(--font-mono); color: var(--text-3); }

  .dir-groups { display: grid; gap: clamp(32px, 4vw, 48px); }
  .dir-group[hidden] { display: none; }
  .dir-gh { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 16px; }
  .dir-gh .icon-tile { margin: 0; }
  .dir-gh h3 { font-size: 1.2rem; margin: 0 0 .2em; }
  .dir-gh p { margin: 0; max-width: 70ch; }
  .dir-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .dir-item { display: flex; flex-direction: column; gap: 10px; padding: 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .dir-item[hidden] { display: none; }
  .dir-top { display: flex; gap: 12px; align-items: center; min-width: 0; }
  .dir-mono { width: 40px; height: 40px; flex: none; display: grid; place-items: center; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border); font: 600 .82rem/1 var(--font-mono); color: var(--accent-text); letter-spacing: .02em; }
  .dir-name { display: grid; gap: 2px; min-width: 0; }
  .dir-name strong { font-size: .98rem; line-height: 1.25; overflow-wrap: anywhere; }
  .dir-kind { font: 500 .7rem/1.2 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); }
  .dir-detail { margin: 0; font-size: .88rem; color: var(--text-2); line-height: 1.5; flex: 1; }
  .dir-status { margin: 0; display: inline-flex; align-items: center; gap: 7px; font: 500 .74rem/1.2 var(--font-mono); color: var(--text-3); }
  .dir-status .dot { width: 6px; height: 6px; background: transparent; border: 1.5px solid var(--accent); }
  .dir-empty { text-align: left; }
  .dir-empty[hidden] { display: none; }
  .dir-empty h3 { font-size: 1.15rem; }
  @media (max-width: 640px) {
    .dir-chip { min-height: 36px; padding: 0 12px; font-size: .82rem; }
    .dir-grid { gap: 8px; }
    .dir-item { padding: 12px 14px; gap: 6px; }
    .dir-mono { width: 34px; height: 34px; font-size: .76rem; }
    .dir-detail { font-size: .84rem; }
  }
</style>
