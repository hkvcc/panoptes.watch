---
/** Side-by-side: what traditional reporting shows vs what business observability adds. */
import Icon from '../Icon.astro';
interface Props { report: string[]; observe: string[]; reportNote?: string; observeNote?: string }
const { report, observe, reportNote = 'Accurate, aggregated, after the fact.', observeNote = 'Connected, continuous, explained in context.' } = Astro.props;
---
<div class="rvo">
  <article class="rvo-col reveal">
    <p class="rvo-k"><Icon name="chart" /> Traditional reporting shows</p>
    <p class="rvo-note">{reportNote}</p>
    <ul>{report.map((r) => <li>{r}</li>)}</ul>
  </article>
  <div class="rvo-mid" aria-hidden="true"><Icon name="arrow" /></div>
  <article class="rvo-col rvo-hl reveal">
    <p class="rvo-k"><Icon name="eye" /> Business observability adds</p>
    <p class="rvo-note">{observeNote}</p>
    <ul class="checklist">{observe.map((r) => <li>{r}</li>)}</ul>
  </article>
</div>
<style>
  .rvo { display: grid; grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr); gap: 12px; align-items: stretch; }
  .rvo-col { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(20px, 2.6vw, 30px); background: var(--surface); }
  .rvo-hl { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 7%, var(--surface)), var(--surface)); }
  .rvo-k { display: flex; align-items: center; gap: 10px; font: 600 1.1rem/1.3 var(--font-display); margin: 0 0 .3rem; }
  .rvo-k :global(svg) { width: 20px; height: 20px; color: var(--accent-text); flex: none; }
  .rvo-note { font-size: .88rem; color: var(--text-3); margin-bottom: 1.1rem; }
  .rvo-col ul:not(.checklist) { margin: 0; padding-left: 1.1rem; display: grid; gap: .65rem; color: var(--text-2); }
  .rvo-col ul:not(.checklist) li::marker { color: var(--text-3); }
  .rvo-col .checklist { color: var(--text); }
  .rvo-mid { display: grid; place-items: center; color: var(--accent-text); }
  .rvo-mid :global(svg) { width: 22px; height: 22px; }
  @media (max-width: 760px) { .rvo { grid-template-columns: minmax(0, 1fr); } .rvo-mid { transform: rotate(90deg); height: 28px; } }
</style>
