---
/**
 * Long-form resource layout: renders the article body, derives reading time and a
 * table of contents from its <h2> headings, and emits Article structured data.
 */
import BaseLayout from './BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { RESOURCES, SITE } from '../data/site';
import { countWords, readingMinutes } from '../lib/reading';

interface Props {
  title: string;          // H1
  metaTitle?: string;     // <title> if different
  description: string;
  eyebrow?: string;
  dek: string;            // standfirst under the title
  related?: string[];     // hrefs of related resources
  published?: string;     // ISO date
  updated?: string;
}
const { title, metaTitle, description, eyebrow = 'Guide', dek, related = [], published = '2026-10-30', updated } = Astro.props;

const slug = (s: string) => s.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
let body = await Astro.slots.render('default');
const toc: { id: string; text: string }[] = [];
body = body.replace(/<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/g, (_m, attrs = '', inner) => {
  const existing = /id="([^"]+)"/.exec(attrs);
  const id = existing ? existing[1] : slug(inner);
  toc.push({ id, text: inner.replace(/<[^>]+>/g, '') });
  return existing ? `<h2${attrs}>${inner}</h2>` : `<h2 id="${id}"${attrs}>${inner}</h2>`;
});
const words = countWords(body);
const minutes = readingMinutes(words);
const relatedItems = related.map((h) => RESOURCES.find((r) => r.href === h)).filter(Boolean) as typeof RESOURCES;
const url = new URL(Astro.url.pathname, SITE.origin).href;
const schema = {
  '@type': 'Article', headline: title.replace(/<[^>]+>/g, ''), description, url, mainEntityOfPage: url,
  datePublished: published, dateModified: updated ?? published, wordCount: words,
  image: new URL('/social/og-resources.png', SITE.origin).href,
  author: { '@type': 'Organization', name: 'Panoptes', url: SITE.origin },
  publisher: { '@type': 'Organization', name: 'Panoptes', url: SITE.origin, logo: { '@type': 'ImageObject', url: new URL('/logos/png/panoptes-symbol-purple-512.png', SITE.origin).href } },
};
---
<BaseLayout title={metaTitle ?? title.replace(/<[^>]+>/g, '')} description={description} ogImage="/social/og-resources.png" ogType="article" schema={schema}
  breadcrumbs={[{ label: 'Resources', href: '/resources/' }, { label: title.replace(/<[^>]+>/g, ''), href: Astro.url.pathname }]}>
  <header class="art-hero bg-glow">
    <div class="bg-grid art-grid" aria-hidden="true"></div>
    <div class="container container-narrow">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/resources/">Resources</a></li><li><span aria-current="page">{eyebrow}</span></li></ol></nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={title} />
      <p class="lede">{dek}</p>
      <div class="art-meta">
        <span><Icon name="clock" /> {minutes} min read</span>
        <span><Icon name="book" /> {words.toLocaleString('en-GB')} words</span>
        <span><Icon name="calendar" /> <time datetime={updated ?? published}>{new Date(updated ?? published).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></span>
      </div>
    </div>
  </header>

  <div class="container art-layout">
    {toc.length > 2 && (
      <aside class="art-toc" aria-label="Table of contents">
        <details open class="toc-box">
          <summary>On this page</summary>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`} data-toc-link>{t.text}</a></li>)}</ol>
        </details>
      </aside>
    )}
    <article class="prose art-body">
      <Fragment set:html={body} />
    </article>
  </div>

  {relatedItems.length > 0 && (
    <section class="section-tight section-alt">
      <div class="container">
        <p class="eyebrow">Keep reading</p>
        <h2 class="mb-2">Related resources</h2>
        <div class="grid grid-3">
          {relatedItems.map((r) => (
            <a href={r.href} class="card card-link">
              <span class="icon-tile"><Icon name={r.icon ?? 'book'} /></span>
              <h3>{r.label}</h3>
              <span class="link-arrow">Read</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <CTA title="Make your business observable." text="See how Panoptes models, observes and explains the way your business actually operates." />
</BaseLayout>

<style>
  .art-hero { padding: clamp(48px, 7vw, 96px) 0 clamp(32px, 5vw, 56px); border-bottom: 1px solid var(--border); position: relative; overflow: hidden; }
  .art-grid { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); }
  .art-hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .art-meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 1.6rem; font: 500 .8rem/1 var(--font-mono); color: var(--text-3); }
  .art-meta span { display: inline-flex; align-items: center; gap: 7px; }
  .art-meta :global(svg) { width: 15px; height: 15px; }
  .art-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); padding-block: clamp(40px, 6vw, 72px) var(--section); align-items: start; }
  .art-layout:not(:has(.art-toc)) { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .art-toc { position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 48px); overflow: auto; }
  .toc-box summary { font: 500 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); cursor: pointer; padding: 6px 0 14px; list-style: none; }
  .toc-box summary::-webkit-details-marker { display: none; }
  .toc-box ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--border); }
  .toc-box a { display: block; padding: 7px 0 7px 16px; margin-left: -1px; border-left: 2px solid transparent; color: var(--text-2); text-decoration: none; font-size: .88rem; line-height: 1.4; }
  .toc-box a:hover { color: var(--text); }
  .toc-box a.active { color: var(--accent-text); border-left-color: var(--accent); font-weight: 600; }
  .art-body { max-width: 72ch; }
  .art-body :global(> h2:first-child) { margin-top: 0; }
  @media (max-width: 960px) {
    .art-layout { grid-template-columns: minmax(0, 1fr); }
    .art-toc { position: static; max-height: none; border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 18px; background: var(--surface-2); }
    .toc-box summary { padding-bottom: 0; }
    .toc-box[open] summary { padding-bottom: 12px; }
  }
</style>
