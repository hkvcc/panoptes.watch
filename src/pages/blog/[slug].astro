---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import ShareLinks from '../../components/blog/ShareLinks.astro';
import { BLOG_TITLE, formatDate, getPosts, isRasterImage, isoDate, relatedPosts, type Post } from '../../lib/blog';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((h) => h.depth === 2);
const related = relatedPosts(post, all);
const ogImage = isRasterImage(post.cover) ? post.cover : '/social/og-resources.png';

const schema = {
  '@type': 'BlogPosting',
  headline: post.heading,
  name: post.seoTitle,
  description: post.description,
  url: post.url,
  mainEntityOfPage: post.url,
  datePublished: isoDate(post.published),
  dateModified: isoDate(post.updated ?? post.published),
  wordCount: post.words,
  articleSection: post.category.label,
  ...(post.tags.length && { keywords: post.tags.map((t) => t.label).join(', ') }),
  image: new URL(ogImage, SITE.origin).href,
  inLanguage: 'en-GB',
  isPartOf: { '@type': 'Blog', name: BLOG_TITLE, url: new URL('/blog/', SITE.origin).href },
  author: { '@type': 'Person', name: post.author.name, jobTitle: post.author.role, url: post.author.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.origin, logo: { '@type': 'ImageObject', url: new URL('/logos/png/panoptes-symbol-purple-512.png', SITE.origin).href } },
};
const crumbs = [{ label: 'Blog', href: '/blog/' }, { label: post.heading, href: post.href }];
---
<BaseLayout title={post.seoTitle} description={post.description} ogImage={ogImage} ogType="article" schema={schema} breadcrumbs={crumbs} noindex={post.draft}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.published.toISOString()} />
    {post.updated && <meta property="article:modified_time" content={post.updated.toISOString()} />}
    <meta property="article:section" content={post.category.label} />
    {post.tags.map((t) => <meta property="article:tag" content={t.label} />)}
    <link rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href="/blog/rss.xml" />
  </Fragment>

  <header class="post-hero bg-glow">
    <div class="bg-grid post-grid" aria-hidden="true"></div>
    <div class="container post-hero-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a href="/">Home</a></li><li><a href="/blog/">Blog</a></li><li><a href={`/blog/?category=${post.category.slug}`}>{post.category.label}</a></li></ol>
      </nav>
      {post.draft && <p class="badge badge-warn post-draft">Draft — not published</p>}
      <h1>{post.heading}</h1>
      <p class="lede">{post.description}</p>
      <div class="post-meta">
        <span class="post-byline"><Icon name="users" /> <span>By <a href={post.author.href} rel="author">{post.author.name}</a>, {post.author.role}</span></span>
        <span><Icon name="calendar" /> <time datetime={isoDate(post.published)}>{formatDate(post.published)}</time></span>
        {post.updated && <span>Updated <time datetime={isoDate(post.updated)}>{formatDate(post.updated)}</time></span>}
        <span><Icon name="clock" /> {post.minutes} min read</span>
      </div>
    </div>
  </header>

  {post.cover && (
    <figure class="container post-cover">
      <img src={post.cover} alt={post.coverAlt} loading="eager" decoding="async" />
    </figure>
  )}

  <div class:list={['container', 'post-layout', { 'no-toc': toc.length < 3 }]}>
    {toc.length >= 3 && (
      <aside class="post-toc" aria-label="Table of contents">
        <details open class="toc-box">
          <summary>On this page</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>)}</ol>
        </details>
      </aside>
    )}
    <div class="post-main">
      <article class="prose post-body">
        <Content />
      </article>

      <footer class="post-foot">
        {post.tags.length > 0 && (
          <div class="post-tags">
            <p class="post-foot-label">Tags</p>
            <ul>{post.tags.map((t) => <li><a href={`/blog/?tag=${t.slug}`} class="badge badge-outline">{t.label}</a></li>)}</ul>
          </div>
        )}
        <div class="post-author">
          <p class="post-foot-label">About the author</p>
          <p class="post-author-name"><a href={post.author.href} rel="author">{post.author.name}</a> <span>{post.author.role}</span></p>
          <p class="post-author-tag">{post.author.tagline}</p>
          <a href={post.author.href} class="link-arrow">More from {post.author.name.split(' ')[0]}</a>
        </div>
        <ShareLinks title={post.heading} url={post.url} />
        <a href="/blog/" class="post-back"><span aria-hidden="true">←</span> All articles</a>
      </footer>
    </div>
  </div>

  {related.length > 0 && (
    <section class="section-tight section-alt">
      <div class="container container-wide">
        <p class="eyebrow">Keep reading</p>
        <h2 class="post-rel-h">Related articles</h2>
        <ul class="post-rel">{related.map((p) => <BlogCard post={p} />)}</ul>
      </div>
    </section>
  )}

  <CTA title="See your own operations this way." text="Panoptes is designed to model how work, money and customers move through your business, and to flag where that flow changes." />
</BaseLayout>

<style>
  .post-hero { padding: clamp(44px, 6vw, 88px) 0 clamp(32px, 4.5vw, 52px); border-bottom: 1px solid var(--border); position: relative; overflow: hidden; }
  .post-grid { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); }
  .post-hero-inner { max-width: 960px; }
  .post-hero h1 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); line-height: 1.1; max-width: 24ch; }
  .post-hero .lede { max-width: 64ch; }
  .post-draft { margin-bottom: 1rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 1.5rem; font: 500 .8rem/1.3 var(--font-mono); color: var(--text-3); }
  .post-meta span { display: inline-flex; align-items: center; gap: 7px; }
  .post-meta :global(svg) { width: 15px; height: 15px; }
  .post-byline a { color: var(--text-2); text-decoration: underline; text-decoration-color: var(--border-strong, var(--border)); text-underline-offset: 3px; }
  .post-byline a:hover { color: var(--accent-text); }
  .post-cover { margin-top: clamp(28px, 4vw, 48px); max-width: 1100px; }
  .post-cover img { width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--border); display: block; }

  .post-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); padding-block: clamp(40px, 6vw, 72px) var(--section); align-items: start; }
  .post-layout.no-toc { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .post-main { min-width: 0; }
  .post-toc { position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 48px); overflow: auto; }
  .toc-box summary { font: 500 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); cursor: pointer; padding: 6px 0 14px; list-style: none; }
  .toc-box summary::-webkit-details-marker { display: none; }
  .toc-box ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--border); }
  .toc-box a { display: block; padding: 7px 0 7px 16px; margin-left: -1px; border-left: 2px solid transparent; color: var(--text-2); text-decoration: none; font-size: .88rem; line-height: 1.4; }
  .toc-box a:hover { color: var(--text); }
  .toc-box a:global(.active) { color: var(--accent-text); border-left-color: var(--accent); font-weight: 600; }

  /* Article body: Markdown output (headings, lists, tables, code, images) */
  .post-body { max-width: 72ch; overflow-wrap: break-word; } /* long bare URLs must not widen the page on mobile */
  .post-body :global(> h2:first-child) { margin-top: 0; }
  .post-body :global(h2), .post-body :global(h3) { scroll-margin-top: calc(var(--header-h) + 24px); }
  .post-body :global(h4) { font-size: 1.05rem; margin-top: 1.8em; }
  .post-body :global(a) { color: var(--accent-text); text-underline-offset: 3px; }
  .post-body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--border); }
  .post-body :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 2.6em 0; }
  .post-body :global(:not(pre) > code) { background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; padding: .1em .35em; font-size: .86em; overflow-wrap: anywhere; }
  .post-body :global(pre) { margin: 1.6em 0; padding: 1.1em 1.25em; border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; font-size: .86rem; line-height: 1.6; background: var(--surface-2); tab-size: 2; }
  .post-body :global(pre code) { font-family: var(--font-mono); font-size: inherit; }
  .post-body :global(.astro-code) { background-color: var(--shiki-light-bg) !important; }
  .post-body :global(.astro-code span) { color: var(--shiki-light); }
  :global([data-theme='dark']) .post-body :global(.astro-code) { background-color: var(--shiki-dark-bg) !important; border-color: var(--border); }
  :global([data-theme='dark']) .post-body :global(.astro-code span) { color: var(--shiki-dark); }
  .post-body :global(table) { font-size: .92rem; }
  .post-body :global(td code), .post-body :global(th code) { white-space: nowrap; }

  .post-foot { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); display: grid; gap: 1.6rem; max-width: 72ch; }
  .post-foot-label { font: 500 .72rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); margin: 0 0 .8rem; }
  .post-tags ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .post-tags a { text-decoration: none; font-size: .78rem; padding: .45em .85em; }
  .post-tags a:hover { border-color: var(--accent); color: var(--accent-text); }
  .post-author { padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); }
  .post-author-name { margin: 0 0 .25rem; font: 600 1.05rem/1.35 var(--font-display); display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .post-author-name a { color: var(--text); text-decoration: none; }
  .post-author-name a:hover { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .post-author-name span { font: 500 .78rem/1.3 var(--font-mono); color: var(--text-3); }
  .post-author-tag { margin: 0 0 .8rem; color: var(--text-2); font-size: .95rem; }
  .post-author .link-arrow { font-size: .92rem; }
  .post-back { justify-self: start; color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .post-back:hover { text-decoration: underline; text-underline-offset: 3px; }

  .post-rel-h { margin-bottom: 1.6rem; }
  .post-rel { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  @media (max-width: 1000px) { .post-rel { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 960px) {
    .post-layout { grid-template-columns: minmax(0, 1fr); }
    .post-toc { position: static; max-height: none; border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 18px; background: var(--surface-2); }
    .toc-box summary { padding-bottom: 0; }
    .toc-box[open] summary { padding-bottom: 12px; }
  }
  @media (max-width: 640px) { .post-rel { grid-template-columns: minmax(0, 1fr); } }
</style>
