---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import FeaturedArticle from '../../components/blog/FeaturedArticle.astro';
import BlogBrowser from '../../components/blog/BlogBrowser.astro';
import { BLOG_TITLE, getPosts, isoDate, pickFeatured } from '../../lib/blog';
import { SITE } from '../../data/site';

const posts = await getPosts();
const featured = pickFeatured(posts);
const crumbs = [{ label: 'Blog', href: '/blog/' }];
const url = new URL('/blog/', SITE.origin).href;
const schema = {
  '@type': 'Blog', name: BLOG_TITLE, url, inLanguage: 'en-GB',
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.origin },
  ...(posts.length && {
    blogPost: posts.slice(0, 20).map((p) => ({ '@type': 'BlogPosting', headline: p.heading, url: p.url, datePublished: isoDate(p.published), author: { '@type': 'Person', name: p.author.name, url: p.author.url } })),
  }),
};
---
<BaseLayout
  title="Blog: business observability in practice"
  description="Articles from Panoptes on business observability: monitoring business processes, KPIs and outcomes, with worked examples and implementation guidance."
  ogImage="/social/og-resources.png"
  schema={schema}
  breadcrumbs={crumbs}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href="/blog/rss.xml" />

  <header class="blog-hero bg-glow">
    <div class="bg-grid blog-grid" aria-hidden="true"></div>
    <div class="container container-wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><span aria-current="page">Blog</span></li></ol></nav>
      <div class="blog-hero-row">
        <div>
          <p class="eyebrow">Panoptes blog</p>
          <h1>Business observability in practice</h1>
          <p class="lede">Articles on watching how a business actually runs: process flow, customer journeys, revenue and the signals between them. Written to be useful whether or not you use Panoptes.</p>
        </div>
        <div class="blog-hero-links">
          <a href="/resources/" class="link-arrow">In-depth guides</a>
          <a href="/blog/rss.xml" class="blog-rss"><Icon name="signal" /> RSS feed</a>
        </div>
      </div>
    </div>
  </header>

  {/* With no published articles the page is just the hero and CTA: no placeholder copy. */}
  {posts.length > 0 && (
    <section class="section-tight blog-main">
      <div class="container container-wide">
        {featured && <FeaturedArticle post={featured} />}
        <BlogBrowser posts={posts} featuredId={featured?.id} />
      </div>
    </section>
  )}

  <CTA title="See your own operations this way." text="Panoptes is designed to model how work, money and customers move through your business, and to flag where that flow changes." />
</BaseLayout>

<style>
  .blog-hero { padding: clamp(48px, 7vw, 96px) 0 clamp(36px, 5vw, 56px); border-bottom: 1px solid var(--border); position: relative; overflow: hidden; }
  .blog-grid { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); mask-image: radial-gradient(ellipse 70% 80% at 60% 0%, #000, transparent 75%); }
  .blog-hero h1 { font-size: clamp(2.3rem, 5vw, 3.8rem); max-width: 18ch; }
  .blog-hero .lede { max-width: 60ch; margin-bottom: 0; }
  .blog-hero-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; }
  .blog-hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-bottom: 6px; }
  .blog-rss { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); text-decoration: none; font-weight: 500; }
  .blog-rss:hover { color: var(--accent-text); }
  .blog-rss :global(svg) { width: 16px; height: 16px; }
  .blog-main { padding-bottom: var(--section); }
</style>
