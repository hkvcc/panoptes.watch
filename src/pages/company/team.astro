---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { SITE } from '../../data/site';

const crumbs = [{ label: 'Company', href: '/company/' }, { label: 'Team', href: '/company/team/' }];

// Only these two people and these facts are approved for publication.
const people = [
  { name: 'Kieran Lovell', role: 'Product Lead', initials: 'KL', bio: 'Business Intelligence turned BusinessOS SME', links: [{ label: 'Platform overview', href: '/platform/' }, { label: 'Vision', href: '/company/vision/' }] },
  { name: 'Florian Andrews', role: 'Journey Intelligence', initials: 'FA', bio: 'ex BCG BPA Consultant forging the ultimate agentic chief of staff', links: [{ label: 'Journey Intelligence', href: '/platform/journey-intelligence/' }, { label: 'AI Intelligence', href: '/platform/ai-intelligence/' }] },
];

const schema = [
  {
    '@type': 'AboutPage', name: 'The Panoptes team', url: new URL('/company/team/', SITE.origin).href, inLanguage: 'en-GB',
    mainEntity: { '@type': 'Organization', name: SITE.name, url: SITE.origin },
  },
  ...people.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role, description: p.bio, worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.origin } })),
];
---
<BaseLayout
  title="Team and Leadership"
  description="Meet the Panoptes team: Kieran Lovell, Product Lead, and Florian Andrews, Journey Intelligence — the people building observability for the whole business."
  ogImage="/social/og-company.png"
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageHero
    eyebrow="Company · Team"
    title="The Panoptes <span class='gradient-text'>team</span>"
    lede="The people building Panoptes, the Business Observability platform — a connected, continuously updated view of how a business actually operates."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Leadership" title="Who is building Panoptes" />
      <ul class="people" role="list">
        {people.map((p) => (
          <li class="card person reveal">
            <span class="avatar" aria-hidden="true">{p.initials}</span>
            <div>
              <h3>{p.name}</h3>
              <p class="role">{p.role}</p>
              <p class="bio">“{p.bio}”</p>
              <ul class="pill-list" aria-label={`Related to ${p.name}’s work`}>
                {p.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container split split-top">
      <div>
        <p class="eyebrow">What we are building</p>
        <h2>Observability for the entire business</h2>
        <p class="lede">Software teams can see inside their systems at any moment. The people who run the business usually cannot see inside the business itself. Panoptes exists to close that gap.</p>
        <p class="muted">Read <a href="/company/">about Panoptes</a> for the mission and the principles we build by, and the <a href="/company/vision/">vision</a> for where it leads: toward a Business Operating System.</p>
      </div>
      <RelatedLinks title="Keep exploring" items={[
        { label: 'About Panoptes', href: '/company/', desc: 'Mission and the idea behind the name', icon: 'eye' },
        { label: 'Vision', href: '/company/vision/', desc: 'Toward a Business Operating System', icon: 'compass' },
        { label: 'Trust center', href: '/trust/', desc: 'Security, privacy and legal', icon: 'shield' },
        { label: 'Contact', href: '/contact/', desc: 'Talk to the team', icon: 'mail' },
      ]} />
    </div>
  </section>

  <CTA title="Talk to the people building it." text="Questions about the product or how your business could be made observable — email reaches the team directly." primary={{ label: 'Contact us', href: '/contact/' }} secondary={{ label: 'Book a Demo', href: '/demo/' }} />
</BaseLayout>

<style>
  .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .person { display: flex; gap: 20px; align-items: flex-start; }
  .avatar { flex: none; width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; font: 600 1.4rem/1 var(--font-display); color: var(--accent-text); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); }
  .person h3 { margin: 0; }
  .role { font: 500 .78rem/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text); margin: .35rem 0 .8rem; }
  .bio { font: 500 1.08rem/1.45 var(--font-display); color: var(--text); }
  .person .pill-list a { color: inherit; text-decoration: none; }
  .person .pill-list a:hover { color: var(--accent-text); }
  @media (max-width: 760px) { .people { grid-template-columns: minmax(0, 1fr); } .person { flex-direction: column; } }
</style>
