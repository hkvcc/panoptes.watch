const faqs = [
  { q: 'Is a semantic layer the same as a data warehouse?', a: 'No. A data warehouse stores data. A semantic layer sits on top of stored data and defines what business terms and metrics mean, so that every tool and query calculates them the same way.' },
  { q: 'What is the difference between a semantic layer and a metrics layer?', a: 'The terms overlap and are often used interchangeably. "Metrics layer" usually emphasises metric definitions; "semantic layer" is broader and also covers entities, relationships, dimensions and business-friendly names.' },
  { q: 'Do small organisations need a semantic layer?', a: 'Not necessarily as a separate tool. What every organisation needs is agreed, written, owned definitions for the measures it runs on. A semantic layer is one way to make those definitions enforceable once several tools and teams depend on them.' },
  { q: 'Is Panoptes a semantic layer?', a: 'No. Panoptes is designed as a business observability platform. It relies on governed definitions in its own model of the business, and can work alongside an existing warehouse and semantic layer rather than replacing them.' },
];
