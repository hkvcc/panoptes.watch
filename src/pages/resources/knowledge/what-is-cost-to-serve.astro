import KnowledgeArticle from '../../../components/knowledge/KnowledgeArticle.astro';

const faqs = [
  { q: 'Is cost to serve the same as cost of goods sold?', a: 'No. Cost of goods sold covers what it costs to make or buy the product itself. Cost to serve covers what it costs to get that product to one customer and keep them happy afterwards, such as delivery, support contacts, rework and returns.' },
  { q: 'Can a customer be profitable on paper and still lose money?', a: 'Yes. Two customers can pay the same price and have the same gross margin, yet one may need many more support contacts, corrections and special handling. Once those costs are counted, the second customer can be far less profitable.' },
  { q: 'Is cost to serve only for logistics?', a: 'No. It started in logistics and distribution, but any business that spends effort on individual customers has a cost to serve: software companies, banks, insurers and services firms included.' },
  { q: 'How often should we calculate cost to serve?', a: 'Often enough to act on it. A once-a-year study is a good start, but the activities behind it, such as contacts and exceptions, change weekly. Watching the drivers more often shows a problem long before the annual number does.' },
];
---
